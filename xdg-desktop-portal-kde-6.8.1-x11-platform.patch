--- a/src/xdg-desktop-portal-kde.cpp	2026-10-21 18:48:18.571331498 +0200
+++ b/src/xdg-desktop-portal-kde.cpp	2026-10-21 18:48:18.571407569 +0200
@@ -23,11 +23,38 @@
 
 using namespace Qt::StringLiterals;
 
+// Qt selects the wayland platform plugin ahead of xcb when WAYLAND_DISPLAY is
+// set (including an empty value) or XDG_SESSION_TYPE=wayland, unless
+// QT_QPA_PLATFORM is already set. On X11, startplasma publishes
+// XDG_SESSION_TYPE=x11 and QT_QPA_PLATFORM=xcb before session services start.
+// A Wayland session must not be forced onto xcb here. kwin_wayland_wrapper
+// creates its socket as wayland-1, not wayland-0, and only then publishes
+// WAYLAND_DISPLAY. The portal is dbus-activated after the compositor is ready.
+// Restart=no, so a wrong platform would stick for the whole session.
+static void selectX11PlatformIfNeeded()
+{
+    const QByteArray sessionType = qgetenv("XDG_SESSION_TYPE");
+    if (sessionType == "wayland") {
+        return;
+    }
+    if (sessionType != "x11" && !qEnvironmentVariableIsSet("DISPLAY")) {
+        return;
+    }
+
+    qunsetenv("WAYLAND_DISPLAY");
+    qunsetenv("WAYLAND_SOCKET");
+    const QByteArray platform = qgetenv("QT_QPA_PLATFORM");
+    if (platform.isEmpty() || platform.startsWith("wayland")) {
+        qputenv("QT_QPA_PLATFORM", QByteArrayLiteral("xcb"));
+    }
+}
+
 int main(int argc, char *argv[])
 {
     // Do not try to reconnect to the compositor as KWayland can't handle that
     // Reconsider enabling when we do not use KWayland anymore
     qunsetenv("QT_WAYLAND_RECONNECT");
+    selectX11PlatformIfNeeded();
     QCoreApplication::setAttribute(Qt::AA_DisableSessionManager);
     QApplication a(argc, argv);
     a.setQuitOnLastWindowClosed(false);
